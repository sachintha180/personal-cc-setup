{
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ~/.claude/statusline.ps1"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "copilot-studio@skills-for-copilot-studio": true
  },
  "extraKnownMarketplaces": {
    "skills-for-copilot-studio": {
      "source": {
        "source": "github",
        "repo": "microsoft/skills-for-copilot-studio"
      }
    }
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "voiceEnabled": true,
  "model": "sonnet"
}
