{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE/.claude/statusline.ps1\""
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "copilot-studio@skills-for-copilot-studio": true,
    "cloudflare@cloudflare": true,
    "codex@openai-codex": true,
    "ponytail@ponytail": true,
    "skill-creator@claude-plugins-official": true,
    "paddle@claude-community": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "skills-for-copilot-studio": {
      "source": {
        "source": "github",
        "repo": "microsoft/skills-for-copilot-studio"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "idleCompaction": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "skipWorkflowUsageWarning": true
}
